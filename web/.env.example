# All values are public: they are compiled into the browser bundle.

# TestFaucet on Base Sepolia (script/DeployFaucet.s.sol).
NEXT_PUBLIC_FAUCET_ADDRESS=0xBba41830AfEbaDD7298BFC4B0E138c6c90c6D194

# WalletConnect project id from https://cloud.reown.com. Without it only browser-extension wallets connect.
