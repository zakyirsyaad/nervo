# Copy to .env and fill in. Never commit .env.
# Forge scripts read these with vm.env*, and the Python tools in tools/ load .env on start.
# Values below are the deployed main stack on Base Sepolia and Reactive Lasna.

# Test tokens (script/DeployOrigin.s.sol)
WETH=0x29583A3d63FD02f1bE462d4b6A1B1BeCeFcaFB87
USDC=0xb790467931Ad6694747bB90c96ac9b07c0c4DE01

# Main stack
POOL_A=0x82DEA86F73edF0CC76cd2Ff4Ae8612380e63CE6F
POOL_B=0xf68dE754214b013c206AFD5753b9f26428C29228
EXECUTOR=0xb568530a915a7Ae01FBE5917E1B21d666b24DFE4
# Address ArbReactive will have on Lasna. DeployOrigin prints it from LASNA_NONCE.
EXPECTED_REACTIVE=0x0f70a79D1a0DFCB61005AF03084d3bED0e71E932
REACTIVE=0x0f70a79D1a0DFCB61005AF03084d3bED0e71E932

# Deployer nonce on Lasna at the time DeployReactive runs
LASNA_NONCE=

# Funding sent with the deploys, in wei
EXECUTOR_FUNDING_WEI=
REACTIVE_FUNDING_WEI=

# Optional ArbReactive parameters (defaults in script/DeployReactive.s.sol)
# INPUT_AMOUNT=1000000000
# MIN_SURPLUS=2000000
# COST_BUFFER=0
# MAX_SNAPSHOT_AGE=86400
# CALLBACK_GAS_LIMIT=600000
# CALLBACK_TTL=60
# REQUEST_EVERY_CANDIDATE=false

# Benchmark trader (tools/bench_trader.py). Its key lives in .bench-trader.json, never here.
TRADER=

# No-filter comparison stack (script/DeployBaseline.s.sol, tools/prepare_compare.sh)
BASELINE_POOL_A=0x97898610adD7F402C9D6612e5cF69e395eba7AC0
BASELINE_POOL_B=0xE4140Ea6a6152F6F0cf02D13a56B7A7F60781105
BASELINE_EXECUTOR=0x9429334cBda1E85Cd99691aE4f0BBca2786d597C
BASELINE_REACTIVE=0x82DEA86F73edF0CC76cd2Ff4Ae8612380e63CE6F

# Faucet (script/DeployFaucet.s.sol)
WETH_ADDRESS=0x29583A3d63FD02f1bE462d4b6A1B1BeCeFcaFB87
USDC_ADDRESS=0xb790467931Ad6694747bB90c96ac9b07c0c4DE01

# Optional RPC overrides for the Python tools
# BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com
# LASNA_RPC_URL=https://lasna-rpc.rnk.dev/
